{
  "manifest_version": 3,
  "name": "Slack Theme for Messenger",
  "version": "1.0.0",
  "description": "Biến giao diện Messenger trên web thành giao diện Slack desktop hiện đại, tinh gọn.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Slack Theme for Messenger",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.messenger.com/*",
        "https://messenger.com/*",
        "https://www.facebook.com/messages/*",
        "https://facebook.com/messages/*"
      ],
      "css": [
        "css/layout.css",
        "css/slack.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
